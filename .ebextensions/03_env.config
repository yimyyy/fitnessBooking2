# Environment variables for AWS Elastic Beanstalk
# Set these values in the EB console: Configuration → Software → Environment properties
# NEVER commit actual values — only set them via the EB console or AWS CLI
#
# Required environment variables:
#
# DATABASE_URL          - PostgreSQL connection string for RDS instance
#                         e.g. postgresql://user:pass@your-rds-host.rds.amazonaws.com:5432/fitness_booking
#
# JWT_SECRET            - Secret key for signing JWT tokens (use a strong random string)
#
# JWT_EXPIRES_IN        - JWT expiry duration, e.g. "7d"
#
# AWS_REGION            - AWS region where SES is configured, e.g. "us-east-1"
#
# AWS_ACCESS_KEY_ID     - IAM access key with SES send permissions
#                         (On EC2/EB, prefer IAM instance role instead of hardcoded keys)
#
# AWS_SECRET_ACCESS_KEY - IAM secret key (use IAM instance role instead when possible)
#
# SES_FROM_EMAIL        - Verified SES sender email address, e.g. "noreply@yourdomain.com"
#
# FRONTEND_URL          - CloudFront URL for CORS, e.g. "https://d1234567890.cloudfront.net"
#
# CANCELLATION_WINDOW_HOURS - Minimum hours before class that cancellation is allowed (e.g. "24")
#
# NODE_ENV              - Set to "production"
#
# PORT                  - Elastic Beanstalk sets this automatically (default: 8080)

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: "8080"
