# Root-level .env for local development
# Copy to .env and fill in values — never commit .env

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/fitness_booking
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/fitness_booking_test

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── AWS (used for SES email sending) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
SES_FROM_EMAIL=noreply@yourdomain.com

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CANCELLATION_WINDOW_HOURS=24

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Used in client/.env:
VITE_API_URL=http://localhost:8080
